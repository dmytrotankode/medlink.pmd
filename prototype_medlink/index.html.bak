      },

      computed: {
                filteredReconcileRows: function() {
          if (this.reconcileFilter === 'missing') return this.reconcileRowsData.filter(r => r.statusLabel.includes('MISSING'));
          if (this.reconcileFilter === 'rejected') return this.reconcileRowsData.filter(r => r.statusLabel.includes('DISCREPANCY'));
          if (this.reconcileFilter === 'paid') return this.reconcileRowsData.filter(r => r.statusLabel.includes('MATCHED'));
          return this.reconcileRowsData;
        },
        currentTourStepData: function () {
          return this.tourSteps[this.activeTourStep - 1] || null;
        },
currentHospital: function () {
          return this.dataStore.hospitals?.[this.selectedHospitalKey] || {};
        },
        records: function () {
          return this.currentHospital.records || [];
        },
        totalRecordsCount: function () {
          return this.currentHospital.stats?.total || this.records.length;
        },
        acceptedCount: function () {
          return this.currentHospital.stats?.tak || this.records.filter(r => r.included === 'Так').length;
        },
        gbCount: function () {
          return this.currentHospital.stats?.gb || this.records.filter(r => r.included === 'ГБ').length;
        },
        rejectedCount: function () {
          return this.currentHospital.stats?.ni || this.records.filter(r => r.included === 'Ні').length;
        },
        acceptedSumFormatted: function () {
          let s = 0;
          this.records.forEach(r => { if (r.included === 'Так') s += parseFloat(this.calculateTariff(r)); });
          const ratio = this.totalRecordsCount / (this.records.length || 1);
          return Math.round(s * ratio).toLocaleString('uk-UA');
        },
        gbSumFormatted: function () {
          let s = 0;
          this.records.forEach(r => { if (r.included === 'ГБ') s += parseFloat(this.calculateTariff(r)); });
          const ratio = this.totalRecordsCount / (this.records.length || 1);
          return Math.round(s * ratio).toLocaleString('uk-UA');
        },
        lostSumFormatted: function () {
          let s = 0;
          this.records.forEach(r => { if (r.included === 'Ні') s += parseFloat(this.calculateTariff(r)); });
          const ratio = this.totalRecordsCount / (this.records.length || 1);
          return Math.round(s * ratio).toLocaleString('uk-UA');
        },
        packageOptions: function () {
          const pkgs = new Set();
          this.records.forEach(r => { if (r.package && r.package !== '-') pkgs.add(r.package); });
          const opts = [{ label: 'Усі пакети', value: 'all' }];
          Array.from(pkgs).sort().forEach(p => opts.push({ label: 'Пакет ' + p, value: p }));
          return opts;
        },
        filteredRecords: function () {
          const t = (this.searchFilter || '').trim();
          const tNorm = this.normalizeIcd ? this.normalizeIcd(t) : t.replace(/\./g, '').toUpperCase();
          return this.records.filter(r => {
            if (this.statusFilter !== 'all' && r.included !== this.statusFilter) return false;
            if (this.packageFilter !== 'all' && !String(r.package).includes(this.packageFilter)) return false;
            if (t) {
              const emzMatch = (r.emz_id || '').toLowerCase().includes(t.toLowerCase());
              const docMatch = (r.doc_name || '').toLowerCase().includes(t.toLowerCase());
              const diagRawMatch = (r.diag_main || '').toLowerCase().includes(t.toLowerCase());
              const diagNormMatch = (this.normalizeIcd ? this.normalizeIcd(r.diag_main) : '').includes(tNorm);
              const svcMatch = (r.services || '').toLowerCase().includes(t.toLowerCase());
              if (!emzMatch && !docMatch && !diagRawMatch && !diagNormMatch && !svcMatch) return false;
            }
            return true;
          });
        },
        filteredDiscrepancies: function () {
          return this.records.filter(r => {
            if (r.included !== 'Ні') return false;
            const err = (r.error_comment || r.error_details || r.error_mismatches || '').toLowerCase();
            if (this.discrepancyTypeFilter === 'mvtn' && !err.includes('мвтн')) return false;
            if (this.discrepancyTypeFilter === 'no_pkg' && !err.includes('жодному пакету')) return false;
            if (this.discrepancyTypeFilter === 'overlap' && !err.includes('перекриття')) return false;
            return true;
          });
        },
        doctorsSummaryList: function () {
          const map = {};
          this.records.forEach(r => {
            const name = r.doc_name || 'Невідомий лікар';
            if (!map[name]) map[name] = { name: name, pos: r.doc_pos || '—', total: 0, tak: 0, gb: 0, ni: 0, rev: 0, lost: 0 };
            const t = parseFloat(this.calculateTariff(r));
            map[name].total++;
            if (r.included === 'Так' || r.included === 'ГБ') {
              if (r.included === 'Так') map[name].tak++; else map[name].gb++;
              map[name].rev += t;
            } else {
              map[name].ni++;
              map[name].lost += t;
            }
          });
          return Object.values(map).map(d => {
            d.errPct = d.total ? ((d.ni / d.total) * 100).toFixed(1) : '0';
            return d;
          }).sort((a,b) => b.total - a.total);
        },
        dsgList: function () {
          return this.dataStore.dsgs || [];
        },
        pkg9Classes: function () {
          return this.dataStore.pkg9_classes || [];
        },
        errorDictionaryList: function () {
          const d = this.dataStore.error_dictionary || {};
          return Object.keys(d).map(k => ({ code: k, desc: d[k] }));
        },
        currentViewTitle: function () {
          const map = {
            'audit': 'Моніторинг та аудит тарифів ПМГ',
            'reconciliation': '2-Way Звірка (Звіт НСЗУ ↔ МІС «Медлінк»)',
            'upload': 'Імпорт та обробка звіту НСЗУ',
            'discrepancies': 'Журнал розбіжностей та втраченого доходу',
            'doctors': 'Статистика за лікарями та пакетами',
            'encounter': 'Пре-білінг у картці взаємодії лікаря',
            'catalog-dsg': 'Довідник 465 ДСГ (Пакети 3, 4, 47)',
            'catalog-pkg9': 'Довідник 148 амбулаторних класів (Пакет 9)',
            'catalog-errors': 'Офіційний словник помилок НСЗУ',
            'docs': 'Технічна документація архітектури'
          };
          return map[this.currentView] || 'Аналітика ПМГ';
        }
      },

      methods: {
        openTourDialog: function (step) {
          this.activeTourStep = step || 1;
          this.guidedTourDialog = true;
        },

        normalizeIcd: function (code) {
          return (code || '').replace(/\./g, '').trim().toUpperCase();
        },

        onSignEncounter: function() {
          if (this.simResult.warning && this.simResult.warning.severity === 'CRITICAL') {
            this.$q.notify({
              message: '⛔ ДІЮ ЗАБЛОКОВАНО: Спеціальність лікаря P122 призведе до дефектури (0 ₴)! Змініть посаду лікаря на P157 перед накладанням КЕП.',
              color: 'negative',
              icon: 'report_problem',
              timeout: 6000
            });
          } else {
            this.$q.notify({
              message: '✓ КЕП успішно накладено! Взаємодію підписано та передано до eHealth (Очікуваний тариф: ' + this.simResult.total.toLocaleString('uk-UA') + ' ₴)',
              color: 'positive',
              icon: 'verified'
            });
          }
        },
        runApiReconciliation: function() {
          this.apiLoading = true;
          const self = this;
          fetch('/api/v1/nszu/statements/stmt-cherkasy-2026-09/reconcile', { method: 'POST' })
            .then(res => res.json())
            .then(data => {
              self.apiLoading = false;
              self.$q.notify({
                message: `API Live (SQLite): 2-Way звірку виконано! Виявлено ${data.invisibleDefekturaCount} невидимих записів на ${data.invisibleDefekturaAmountUah.toLocaleString('uk-UA')} ₴!`,
                color: 'warning',
                icon: 'warning',
                timeout: 5000
              });
            })
            .catch(err => {
              self.apiLoading = false;
              self.$q.notify({ message: 'API Error: ' + err.message, color: 'negative' });
            });
        },
        executeTourAction: function (step) {
          this.guidedTourDialog = false;
          if (step === 1) {
            this.currentView = 'upload';
            this.$q.notify({ message: 'Крок 1: Запуск потокового імпорту та 5-крокового аналізу...', color: 'info' });
            this.simulateUpload('oco');
          } else if (step === 2) {
            this.currentView = 'audit';
            this.$q.notify({ message: 'Крок 2: Відкриваємо детальний аудит 45 колонок для першого пацієнта...', color: 'primary' });
            if (this.records.length > 0) this.openDetails45(this.records[0]);
          } else if (step === 3) {
            this.currentView = 'discrepancies';
            this.discrepancyTypeFilter = 'all';
            this.$q.notify({ message: 'Крок 3: Перехід до журналу 2-Way звірки та виявлення невидимих випадків...', color: 'warning' });
          } else if (step === 4) {
            this.currentView = 'discrepancies';
            const niRec = this.records.find(r => r.included === 'Ні') || this.records[0];
            this.$q.notify({ message: 'Крок 4: Відкриваємо 2-Way виправлення дефектури для відновлення виплати...', color: 'negative' });
            this.openCorrectionDialog(niRec);
          } else if (step === 5) {
            this.currentView = 'doctors';
            this.$q.notify({ message: 'Крок 5: Зведений аркуш «Звіт» (по лікарях та відділеннях)...', color: 'teal' });
          } else if (step === 6) {
            this.currentView = 'encounter';
            this.simPackage = '4';
            this.simDiag = 'C180'; // Without dot!
            this.simSvc = '30061-02';
            this.calcSimulation();
            this.$q.notify({ message: 'Крок 6: Симулятор лікаря — перевірено діагноз без крапки (C180) та посаду P157!', color: 'positive' });
          } else if (step === 7) {
            this.currentView = 'catalog-dsg';
            this.catalogSearch = 'A15';
            this.$q.notify({ message: 'Крок 7: Відкрито довідник 465 ДСГ та нормативні тарифи...', color: 'primary' });
          }
        },

        downloadAnalyzedFile: function () {
          let csv = "\uFEFFID ЕМЗ;Дата;Лікар;Посада;Відділення;Пакет;Основний діагноз;Інтервенція АКПІ;Статус НСЗУ;Розрахований Тариф МІС;Фактична Оплата;Різниця;Причина відхилення\n";
          this.records.slice(0, 150).forEach(r => {
            const tariff = this.calculateTariff(r);
            const nszuPay = r.included === 'Так' ? tariff : (r.included === 'ГБ' ? (tariff * 0.55).toFixed(2) : '0.00');
            const diff = (parseFloat(tariff) - parseFloat(nszuPay)).toFixed(2);
            csv += `"${r.emz_id}";"${r.date}";"${r.doc_name}";"${r.doc_pos}";"${r.dept}";"${r.package}";"${r.diag_main}";"${r.services}";"${r.included}";"${tariff}";"${nszuPay}";"${diff}";"${r.error_comment || ''}"\n`;
          });
          const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${this.currentHospital.filename ? this.currentHospital.filename.replace('.xlsx', '') : 'Вересень_2026'}_analyzed.csv`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          this.$q.notify({
            message: '📥 Файл _analyzed.csv успішно завантажено на комп'ютер!',
            color: 'positive',
            icon: 'cloud_download',
            timeout: 3000
          });
        },

        calculateTariff: function (r) {
          const p = String(r.package || '');
          if (p.startsWith('3') || p.startsWith('4') || p.startsWith('47')) {
            const base = 8735.0;
            let coeff = 1.65;
            if (r.diag_main?.includes('C') || r.diag_main?.includes('D')) coeff = 2.856;
            else if (r.diag_main?.includes('I')) coeff = 3.15;
            else if (r.diag_main?.includes('K')) coeff = 2.78;
            const extraK = p.startsWith('47') ? 0.60 : 0.55;
            return (base * coeff * extraK).toFixed(2);
          } else if (p.startsWith('9')) {
            return (155.0 * 1.29).toFixed(2);
          } else if (p.startsWith('17') || p.startsWith('38')) {
            return (17865.0).toFixed(2);
          } else if (p.startsWith('18')) {
            return (54089.0).toFixed(2);
          } else if (p.startsWith('10')) {
            return (512.0).toFixed(2);
          } else if (p.startsWith('12') || p.startsWith('13') || p.startsWith('15')) {
            return (1180.0).toFixed(2);
          } else if (p.startsWith('54') || p.startsWith('53')) {
            return (10820.0).toFixed(2);
          } else {
            return (2450.0).toFixed(2);
          }
        },

        onHospitalChanged: function () {
          this.$q.notify({
            message: `Завантажено дані закладу: ${this.currentHospital.name}`,
            color: 'primary',
            icon: 'apartment'
          });
        },

        refreshData: function () {
          this.$q.notify({ message: 'Дані оновлено', color: 'positive', icon: 'check' });
        },

        exportExcel: function () {
          this.$q.notify({
            message: `Експорт Excel-звіту з тарифами (${this.currentHospital.name}) сформовано.`,
            color: 'positive',
            icon: 'cloud_download'
          });
        },

        simulateUpload: function (hospKey) {
          this.uploadInProgress = true;
          this.uploadComplete = false;
          this.uploadProgress = 15;
          this.uploadStatusTitle = hospKey === 'oco' ? 'Аналіз файлу: Вересень 26.xlsx (ОЦО)...' : 'Аналіз файлу: 02000334_SF_2026.xlsx (ДКЛ)...';
          this.step1Status = '4 аркуші знайдено ✓';
          this.step2Status = 'Очікування...';
          this.step3Status = 'Очікування...';
          this.step4Status = 'Очікування...';

          setTimeout(() => { this.uploadProgress = 50; this.step2Status = '45 колонок верифіковано ✓'; }, 300);
          setTimeout(() => { this.uploadProgress = 80; this.step3Status = 'Тарифи ПМГ нараховано ✓'; }, 600);
          setTimeout(() => {
            this.uploadProgress = 100;
            this.step4Status = '2-Way співставлено ✓';
            this.uploadInProgress = false;
            this.uploadComplete = true;
            this.selectedHospitalKey = hospKey;
          }, 900);
        },

        calcSimulation: function () {
          const self = this;
          const pkg = this.simPackage;
          const rawDiag = this.simDiag || 'C180';
          const diagNorm = rawDiag.replace(/\./g, '').trim().toUpperCase();
          const svc = this.simSvc || '32003-00';
          const mountain = parseFloat(this.simMountain) || 1.0;
          const docPos = this.simDoctorPos || 'P157';
          const admType = this.simAdmissionType || 'Планова';

          // Call Real Live SQLite REST API
          fetch('/api/v1/pmg/prebilling/calculate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              icdCode: rawDiag,
              serviceCode: svc,
              doctorPosition: docPos,
              admissionType: admType,
              isMountain: mountain > 1.0
            })
          })
          .then(res => res.json())
          .then(data => {
            self.simResult = {
              dsgCode: data.dsgCode,
              dsgName: data.dsgTitle,
              baseRate: 8735.0,
              coeff: data.weightCoefficient,
              total: data.calculatedTariffUah,
              warning: data.antiDefekturaCheck?.warning
            };
            if (data.antiDefekturaCheck?.isValid) {
              self.$q.notify({
                message: `✓ Пре-білінг успішний: Тариф ${data.calculatedTariffUah.toLocaleString('uk-UA')} ₴ • Посада ${docPos} валідна`,
                color: 'positive',
                icon: 'check_circle'
              });
            } else {
              self.$q.notify({
                message: `⛔ КРИТИЧНО: ${data.antiDefekturaCheck?.warning?.message}`,
                color: 'negative',
                icon: 'report_problem',
                timeout: 5000
              });
            }
          })
          .catch(err => {
            console.warn('Fallback to local calc:', err);
            // Local fallback calculation
            let coeff = (svc.includes('32003')) ? 2.766 : (svc.includes('30518') ? 2.340 : 1.0);
            let baseRate = (pkg === '9') ? 155.0 : 8735.0;
            let extraK = (pkg === '4') ? 0.60 : 0.55;
            let kPlan = (admType === 'Планова') ? 0.80 : 1.0;
            let total = Math.round(baseRate * coeff * extraK * kPlan * mountain * 100) / 100;
            let warn = null;
            if (docPos === 'P122') {
              warn = {
                code: 'ERR_DOC_SPEC_04',
                severity: 'CRITICAL',
                message: 'Спеціальність терапевта (P122) не дозволяє кодування операції 32003-00. Випадок буде відхилено НСЗУ (0 ₴)!',
                legalBasis: 'Наказ МОЗ № 410, п. 4.1',
                advice: 'Призначте лікаря з посадою P157 (Хірург-онколог).'
              };
            }
            self.simResult = {
              dsgCode: 'O0101',
              dsgName: 'Великі хірургічні втручання на ободовій кишці',
              baseRate: baseRate,
              coeff: coeff,
              total: total,
              warning: warn
            };
          });
          return;

          let dsgCode = '—';
          let dsgName = 'Не визначено';
          let coeff = 1.0;
          let baseRate = 8735.0;
          let extraK = 0.55;
          let warning = null;

          if (pkg === '3' || pkg === '4' || pkg === '47') {
            baseRate = 8735.0;
            extraK = pkg === '47' ? 0.60 : 0.55;
            if (diag.startsWith('C')) {
              dsgCode = 'G01';
              dsgName = 'Резекція прямої кишки та онкохірургічні втручання';
              coeff = 5.070;
              if (!svc.includes('30061')) {
                warning = 'Для діагнозу C18.0 обов\'язково потрібна процедура АКПІ 30061-02. Без неї тариф буде 0 грн!';
              }
            } else if (diag.startsWith('I21')) {
              dsgCode = 'F03';
              dsgName = 'Операції на клапанах серця та судинах';
              coeff = 11.005;
            } else if (diag.startsWith('K35')) {
              dsgCode = 'G02';
              dsgName = 'Складні операції на кишечнику';
              coeff = 4.937;
            } else {
              dsgCode = 'E01';
              dsgName = 'Загальносоматична допомога';
              coeff = 1.45;
            }
          } else if (pkg === '9') {
            baseRate = 155.0;
            coeff = 1.29;
            extraK = 1.0;
            dsgCode = 'Клас 1';
            dsgName = 'Консультування та діагностика (Кардіологія)';
          } else if (pkg === '17') {
            baseRate = 17865.0;
            coeff = 1.0;
            extraK = 1.0;
            dsgCode = 'Пакет 17';
            dsgName = 'Хіміотерапевтичне лікування (дорослі)';
          }

          const total = baseRate * coeff * extraK * mountain;
          this.simResult = { dsgCode, dsgName, baseRate, coeff, extraK, total, warning };
        },

        openDetails45: function (rec) {
          this.selectedRecord = rec;
          this.details45Dialog = true;
        },

        getCol45Value: function (r, idx) {
          const values = [
            "2026", "8 або 9", r.emz_type, r.emz_id, r.date,
            r.doc_pos, r.doc_name, r.dept, r.ref_type, r.ref_edrpou,
            r.ref_doc_pos, r.episode_id, r.episode_type, r.start_date, r.start_date,
            r.end_date, r.los, r.diag_main, r.diag_conf, r.diag_clin,
            r.diag_extra, "-", r.services, r.interaction_class, r.priority,
            r.interaction_type, r.admission_reason, r.discharge_outcome, r.patient_id, r.has_decl,
            r.gender, r.age, "-", r.adsg, r.package,
            r.service_code, r.stat_included, r.included, r.error_comment, r.error_details,
            r.error_mismatches, r.error_grouping, r.nszu_review_details, r.extra_notes, "2026-09-21"
          ];
          return values[idx] || '—';
        },

        openCorrectionDialog: function (rec) {
          this.selectedRecord = rec;
          this.correctionDiag = rec.diag_main || 'C18.0';
          this.correctionSvc = rec.services || '30061-02';
          this.correctionDialog = true;
        },

        getAiRecommendation: function (rec) {
          const err = (rec.error_comment || rec.error_details || rec.error_mismatches || '').toLowerCase();
          if (err.includes('мвтн')) {
            return 'ЕМЗ створило МВТН без клінічної виписки. Змініть тип взаємодії або прив\'яжіть до епізоду стаціонару.';
          } else if (err.includes('жодному пакету')) {
            return `Відсутній обов'язковий код АКПІ. Додайте процедуру 30061-02 для віднесення до ДСГ G01 (+24 357.55 ₴).`;
          } else if (err.includes('перекриття')) {
            return 'Виявлено конфлікт часу надання послуг. Об\'єднайте години прийому в один безперервний слот.';
          }
          return 'Верифікуйте код діагнозу відповідно до специфікацій ПМГ-2026 та підпишіть оновленим КЕП.';
        },

        applyCorrection: function () {
          if (!this.selectedRecord) return;
          this.selectedRecord.included = 'Так';
          this.selectedRecord.diag_main = this.correctionDiag;
          this.selectedRecord.services = this.correctionSvc;
          this.selectedRecord.error_comment = '';
          this.selectedRecord.error_details = '';
          this.selectedRecord.error_mismatches = '';

          this.$q.notify({
            message: `✅ Взаємодію ${this.selectedRecord.emz_id.slice(0, 8)} скориговано в Медлінку! Відновлено +24 357.55 ₴. Поставлено в чергу на eHealth.`,
            color: 'positive',
            icon: 'check_circle',
            timeout: 3500
          });
          this.correctionDialog = false;
        },

        openDoc: function (url) {
          window.open(url, '_blank');
        }
      },

      mounted: function () {
        this.calcSimulation();
      }
    });
  </script>
</body>
</html>
